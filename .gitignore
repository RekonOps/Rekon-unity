# ============================================================
# Unity 빌드 / 캐시
# ============================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
[Rr]ecordings/

# Crashlytics generated file
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ============================================================
# IDE
# ============================================================
.idea/
.vs/
.vscode/
*.csproj
*.sln
*.unityproj
*.booproj

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# ============================================================
# OS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# Supabase / 환경 변수
# ============================================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
supabase~/.branches
supabase~/.temp

# ============================================================
# 기타
# ============================================================
*.pidb.meta
*.pdb.meta
sysinfo.txt

# Unity3D generated meta files
*.meta
# UPM 패키지 필수 .meta 파일은 추적 (git URL 설치 시 필요)
!Runtime.meta
!Runtime/**/*.meta
!Editor.meta
!Editor/**/*.meta
!Settings.meta
!Settings/**/*.meta
!Tests.meta
!Tests/**/*.meta
!package.json.meta
!README.md.meta
!LICENSE.meta
!CHANGELOG.md.meta
!SECURITY.md.meta

# ============================================================
# 작업/AI 메타 문서 — repo 에서 제외 (dev 로컬에만 유지, prod·UPM 미포함)
# 기준: 패키지 사용자가 볼 문서(README/CHANGELOG/LICENSE/SECURITY)만 커밋,
#       나머지 작업 메타는 git 에 올리지 않음 → 브랜치 분기 관리 불필요
# ============================================================
CLAUDE.md
CLAUDE.md.meta
CONTEXT.md
CONTEXT.md.meta
findings.md
findings.md.meta
progress.md
progress.md.meta
task_plan.md
task_plan.md.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
